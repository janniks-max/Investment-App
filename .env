# Global Intraday Stock Recommender — Environment Variables
# Copy this file to .env and fill in your values.

# ─── Required ────────────────────────────────────────────────────────────────
# No required env vars for basic operation!
# Yahoo Finance data is fetched without an API key (public endpoint, ~15min delay).

# ─── Optional: Alpha Vantage (fallback data source) ──────────────────────────
# Get a free key at: https://www.alphavantage.co/support/#api-key
# Free tier: 25 requests/day, 5/minute
# Without this, Yahoo Finance is used exclusively.
ALPHAVANTAGE_API_KEY=

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
